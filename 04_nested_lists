#--- Задача 6: Разбиение на чанки ---
def chunked(sym, num):
    count = 1
    gen_list = []
    list1 = []

    for i in range(len(sym)):
        list1.append(sym[i])
        if count == num:
            gen_list.append(list1)
            list1 = []
            count = 0
        count += 1

    if len(list1) != 0:
        gen_list.append(list1)
    return gen_list


symbols = input().split()
n = int(input())

print(chunked(symbols, n))


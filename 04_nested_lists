#--- Задача 7: Суммы четвертей ---
n = int(input())
matrix = []
left =[]
right = []
down = []
up = []

for _ in range(n):
    int_list = [int(i) for i in input().split()]
    matrix.append(int_list)

for i in range(n):
    for j in range(n):
        if i > j:
            if i < n - 1 - j:
                left.append(matrix[i][j])
            elif i > n - 1 - j:
                down.append(matrix[i][j])
        elif i < j:
            if i < n - 1 - j:
                up.append(matrix[i][j])
            elif i > n - 1 -j:
                right.append(matrix[i][j])
print(up, right, down, left)
print("Верхняя четверть:", sum(up))
print("Правая четверть:", sum(right))
print("Нижняя четверть:", sum(down))
print("Левая четверть:", sum(left))
